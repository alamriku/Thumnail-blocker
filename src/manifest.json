{
  "manifest_version": 3,
  "name": "Thumb blocker",
  "description": "Block thumbnails on youtube, and get your attention back from the enticing thumbnail in this noisy world.",
  "background": { "service_worker": "background.bundle.js" },
  "icons": {
    "16": "icon-16.png",
    "128": "icon-128.png",
    "48": "icon-64.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/"],
      "js": ["contentScript.bundle.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon-128.png", "icon-34.png", "icon-16.png"],
      "matches": []
    }
  ],
  "permissions": [
    "storage"
  ]
}
